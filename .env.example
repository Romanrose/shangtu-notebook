# 设置后，Pi SDK 会使用该模型作为手札内核；未设置时只运行本地纸页体验。
PI_MODEL_PROVIDER=
PI_MODEL_ID=
# Pi provider 的认证变量也只在服务端保存；例如 provider=openai 时使用 OPENAI_API_KEY。
OPENAI_API_KEY=
# Saber 独立 Spike 可显式选择同一服务端 OCR adapter；未设置时仍是 fixture-only。
SABER_PI_TRANSCRIPTION_PROVIDER=
SABER_PI_TRANSCRIPTION_MODEL_ID=
# 视觉模型始终由服务端适配器调用；浏览器不读取这些值或任何凭据。
VISION_MODEL_PROVIDER=
VISION_MODEL_ID=
# 速度优先实验候选：华为云手写 OCR。仅服务端读取短期 token；未配置时不会请求网络。
# 仅对单行、紧裁剪笔迹段开启 HUAWEI_OCR_QUICK_MODE=1；多行/不确定段保持 0。数字段可设 HUAWEI_OCR_CHAR_SET=digit。
HUAWEI_OCR_ENDPOINT=
HUAWEI_OCR_PROJECT_ID=
HUAWEI_OCR_AUTH_TOKEN=
HUAWEI_OCR_CHAR_SET=general
HUAWEI_OCR_QUICK_MODE=0
HUAWEI_OCR_DETECT_DIRECTION=0
# 可选实验 provider：OpenAI-compatible Chat Completions 视觉接口；只在服务端使用。
VISION_VLM_ENDPOINT=
VISION_VLM_API_KEY=
# 实验分支可选：自托管 PaddleOCR 3.x 的 /ocr 地址；不配置时不会发起请求。
PADDLEOCR_ENDPOINT=
# 实验分支可选：PaddleOCR-VL 完整 pipeline 的 /layout-parsing 地址；只在服务端调用。
PADDLEOCR_VL_ENDPOINT=
# 实验分支可选：Tesseract stdin provider；仅服务端使用，不写入临时图像文件。
TESSERACT_BIN=
TESSERACT_LANG=chi_sim
TESSDATA_PREFIX=
TESSERACT_PSM=7
# 未来搜韵图谱 gateway：只由服务端读取。未同时配置 HTTPS endpoint 与 token 时，/api/seek 不启动 Pi 或联网。
CNKGRAPH_GATEWAY_ENDPOINT=
CNKGRAPH_GATEWAY_AUTH_TOKEN=
# 仅供开发时完整演练“截图 → 确认 → 寻迹”；不会调用模型或网络，纸页会明确标为演练转写。
NOTEBOOK_FIXTURE_MODE=
# 实验 CLI：真实 PaddleOCR 模式必须指向本地、脱敏的 PNG 样本清单；不提交样本和结果。
TRANSCRIPTION_BENCH_PROVIDER=fixture
# 可选矩阵：逗号分隔，例如 paddleocr,vlm-openai-compatible；同一 manifest/轮数依次运行。
TRANSCRIPTION_BENCH_PROVIDERS=
TRANSCRIPTION_BENCHMARK_MANIFEST=
TRANSCRIPTION_BENCH_RUNS=3
TRANSCRIPTION_BENCH_WARMUP=0
TRANSCRIPTION_BENCH_SHOW_TEXT=0
TRANSCRIPTION_BENCH_OUTPUT=
# 报告来源从 manifest metadata.evidence 派生；此变量只能作为一致性校验。
TRANSCRIPTION_BENCH_EVIDENCE=
TRANSCRIPTION_BENCH_COHORT_ID=
# 脱敏输入预处理标签，例如 casia-scale-1_5；不同标签不能混合比较。
TRANSCRIPTION_BENCH_PREPROCESSING=unknown
# 实验轮次标签，例如 casia-stable-20260813；同一矩阵必须一致。
TRANSCRIPTION_BENCH_RUN_ID=unknown
# consented_user 清单必须在每条样本 metadata 中声明 consent=confirmed。
