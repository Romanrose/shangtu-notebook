{
  "name": "shangtu-notebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve:api": "node server/notebook-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:agent": "node server/check-agent.mjs",
    "bench:transcription": "node server/bench-transcription.mjs",
    "prepare:transcription-manifest": "node server/prepare-transcription-manifest.mjs",
    "prepare:transcription-casia": "python3 server/prepare-casia-wptt-samples.py",
    "summarize:transcription-timing": "node server/summarize-transcription-timings.mjs",
    "preflight:transcription": "node server/preflight-transcription.mjs",
    "compare:transcription": "node server/compare-transcription-reports.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-ai": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
