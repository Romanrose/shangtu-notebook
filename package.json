{
  "name": "shangtu-notebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "serve:api": "node --env-file-if-exists=.env server/notebook-server.mjs",
    "serve:saber-pi": "node --env-file-if-exists=.env spikes/saber-pi/bridge.mjs",
    "serve:souyun-gateway": "node --env-file-if-exists=.env server/souyun-gateway-service.mjs",
    "check:souyun-gateway": "node server/check-souyun-gateway.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:agent": "node server/check-agent.mjs",
    "check:journey-agent": "node server/check-journey-agent.mjs",
    "check:saber-spike": "node spikes/saber-pi/check-fixture.mjs",
    "check:saber-spike-client": "node spikes/saber-pi/check-client.mjs",
    "check:saber-isolation": "node spikes/saber-pi/check-isolation.mjs",
    "bench:transcription": "node --env-file-if-exists=.env server/bench-transcription.mjs",
    "prepare:transcription-manifest": "node server/prepare-transcription-manifest.mjs",
    "prepare:transcription-casia": "python3 server/prepare-casia-wptt-samples.py",
    "summarize:transcription-timing": "node server/summarize-transcription-timings.mjs",
    "preflight:transcription": "node server/preflight-transcription.mjs",
    "preflight:pi": "node --env-file-if-exists=.env server/preflight-pi-model.mjs",
    "preflight:souyun-gateway": "node --env-file-if-exists=.env server/preflight-souyun-gateway.mjs",
    "preflight:services": "node --env-file-if-exists=.env server/preflight-real-services.mjs",
    "compare:transcription": "node server/compare-transcription-reports.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-ai": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
